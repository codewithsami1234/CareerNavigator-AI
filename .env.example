# Copy to .env only if you want a local file. The API reads the process environment.
# Do not put real tokens in this example file.

# Optional. Raises the GitHub API rate limit. Public profiles work without it.
GITHUB_TOKEN=

# Optional. Path to tesseract.exe when it is not on PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Comma-separated browser origins. A * value is ignored.
# Default when unset: http://localhost:5173,http://127.0.0.1:5173
CAREERNAV_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. Leave unset to use research/01_resume_intelligence/data/careernavigator.sqlite
# CAREERNAV_DATABASE_URL=sqlite:///C:/path/careernavigator.sqlite

# Set to 1 only behind HTTPS. Local http://localhost must leave this unset.
CAREERNAV_COOKIE_SECURE=0
